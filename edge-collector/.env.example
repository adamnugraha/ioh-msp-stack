# Values printed by "mspctl proxy add <customer code> <proxy name>"
ZABBIX_IMAGE_TAG=alpine-7.0.31
ZBX_HOSTNAME=proxy-acme-01
ZBX_SERVER_HOST=zabbix.msp.example.internal
ZBX_TLSPSKIDENTITY=psk-proxy-acme-01
TZ=Asia/Jakarta
# The key itself goes in the file zabbix_proxy.psk (one line, hexadecimal), readable only by root:
#   echo "<key>" > zabbix_proxy.psk && chmod 640 zabbix_proxy.psk
