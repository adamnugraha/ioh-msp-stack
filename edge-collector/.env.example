# Values printed by "mspctl proxy add <customer code> <proxy name>"
ZABBIX_IMAGE_TAG=alpine-7.0.31
ZBX_HOSTNAME=proxy-acme-01
ZBX_SERVER_HOST=zabbix.msp.example.internal
ZBX_TLSPSKIDENTITY=psk-proxy-acme-01
TZ=Asia/Jakarta
# The key itself goes in the file zabbix_proxy.psk (one line, hexadecimal). The proxy runs as user zabbix
# (1997:1995) inside its container, so the file belongs to that user and nobody else may read it:
#   echo "<key>" > zabbix_proxy.psk
#   sudo chown 1997:1995 zabbix_proxy.psk && sudo chmod 600 zabbix_proxy.psk
