# The MSP Console preview: the real front end with made-up sample data, served as one page.
# It connects to nothing: no tool, no API, no address outside the page.
#
#   docker build -f Dockerfile.preview -t ioh-msp-stack:console-preview .
#   docker run -d -p 8080:8080 ioh-msp-stack:console-preview      then open http://<server>:8080
#
# With your logo (branding/logo.svg or logo.png, readable by everyone; see branding/README.md):
#   docker run -d -p 8080:8080 -v /opt/ioh-msp-stack/branding:/usr/share/nginx/html/brand:ro ioh-msp-stack:console-preview

FROM node:22-alpine AS build
WORKDIR /src
# Optional: certificate authorities of a TLS-inspecting proxy, as .crt files in certs/ (none by default)
COPY certs/ /usr/local/share/extra-ca/
RUN cat /usr/local/share/extra-ca/*.crt > /usr/local/share/extra-ca.pem 2>/dev/null || true
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/extra-ca.pem
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# The image's page asks this server for a logo; nothing mounted means the neutral mark.
RUN VITE_BRAND_LOGO=./brand/logo npm run build:demo

FROM nginxinc/nginx-unprivileged:1.30-alpine
LABEL org.opencontainers.image.title="MSP Console preview" \
      org.opencontainers.image.description="Clickable preview of the MSP Console with sample data" \
      org.opencontainers.image.source="https://github.com/adamnugraha/ioh-msp-stack"
COPY docker/preview-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist-demo/index.html /usr/share/nginx/html/index.html
EXPOSE 8080
